#!/bin/bash

# manu:summary=Display brightness level using SwayOSD on the current monitor.
# manu:args=<0-100>
# manu:examples=manu swayosd brightness 0 | manu swayosd brightness 50 | manu swayosd brightness 100

percent="$1"

progress="$(awk -v p="$percent" 'BEGIN{printf "%.2f", p/100}')"
[[ $progress == "0.00" ]] && progress="0.01"

manu-swayosd-client \
  --custom-icon display-brightness-symbolic \
  --custom-progress "$progress" \
  --custom-progress-text "${percent}%"
