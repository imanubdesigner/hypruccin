#!/bin/bash

# manu:summary=Launch the manu Menu or takes a parameter to jump straight to a submenu.

export PATH="$HOME/.local/share/manu/bin:$PATH"

# Set to true when going directly to a submenu, so we can exit directly
BACK_TO_EXIT=false
back_to() {
  local parent_menu="$1"
  if [[ "$BACK_TO_EXIT" == "true" ]]; then
    exit 0
  elif [[ -n "$parent_menu" ]]; then
    "$parent_menu"
  else
    show_main_menu
  fi
}
toggle_existing_menu() {
  if pgrep -f "walker.*--dmenu" >/dev/null; then
    walker --close >/dev/null 2>&1
    exit 0
  fi
}
menu() {
  local prompt="$1"
  local options="$2"
  local extra="$3"
  local preselect="$4"
  read -r -a args <<<"$extra"
  if [[ -n "$preselect" ]]; then
    local index
    index=$(echo -e "$options" | grep -nxF "$preselect" | cut -d: -f1)
    if [[ -n "$index" ]]; then
      args+=("-c" "$index")
    fi
  fi
  echo -e "$options" |
    manu-launch-walker --dmenu --width 295 --minheight 1 --maxheight 630 -p "$prompt…" "${args[@]}" 2>/dev/null
}

terminal() {
  xdg-terminal-exec --app-id=org.manu.terminal "$@"
}

present_terminal() {
  manu-launch-floating-terminal-with-presentation $1
}

install() {
  present_terminal "echo 'Installing $1...'; manu-pkg-add $2"
}

install_and_launch() {
  present_terminal "echo 'Installing $1...'; manu-pkg-add $2 && setsid gtk-launch $3"
}

install_font() {
  present_terminal "echo 'Installing $1...'; manu-pkg-add $2 && sleep 2 && manu-font-set '$3'"
}

install_terminal() {
  present_terminal "manu-install-terminal $1"
}

aur_install() {
  present_terminal "echo 'Installing $1 from AUR...'; manu-pkg-aur-add $2"
}

open_in_editor() {
  notify-send -u low "Editing config file" "$1"
  manu-launch-editor "$1"
}
aur_install_and_launch() {
  present_terminal "echo 'Installing $1 from AUR...'; manu-pkg-aur-add $2 && setsid gtk-launch $3"
}

get_webcam_list() {
  v4l2-ctl --list-devices 2>/dev/null | while IFS= read -r line; do
    if [[ $line != $'\t'* && -n $line ]]; then
      local name="$line"
      IFS= read -r device || break
      device=$(echo "$device" | tr -d '\t' | head -1)
      [[ -n $device ]] && echo "$device  $name"
    fi
  done
}

show_webcam_select_menu() {
  local devices=$(get_webcam_list)
  local count=$(echo "$devices" | grep -c . 2>/dev/null || echo 0)
  if [[ -z $devices ]] || ((count == 0)); then
    notify-send "No webcam devices found" -u critical -t 3000
    return 1
  fi
  if ((count == 1)); then
    echo "$devices" | awk '{print $1}'
  else
    menu "Select Webcam" "$devices" | awk '{print $1}'
  fi
}

show_capture_menu() {
  case $(menu "Capture" "  Screenshot\n  Screenrecord\n󰴑  Text Extraction\n󰃉  Color") in
  *Screenshot*) manu-capture-screenshot ;;
  *Screenrecord*) show_screenrecord_menu ;;
  *Text*) manu-capture-text-extraction ;;
  *Color*) pkill hyprpicker || hyprpicker -a ;;
  *) back_to show_trigger_menu ;;
  esac
}

show_screenrecord_menu() {
  manu-capture-screenrecording --stop-recording && exit 0
  case $(menu "Screenrecord" "  With no audio\n  With desktop audio\n  With desktop + microphone audio\n  With desktop + microphone audio + webcam") in
  *"With no audio")
    manu-capture-screenrecording
    ;;
  *"With desktop audio")
    manu-capture-screenrecording --with-desktop-audio
    ;;
  *"With desktop + microphone audio")
    manu-capture-screenrecording --with-desktop-audio --with-microphone-audio
    ;;
  *"With desktop + microphone audio + webcam")
    local device=$(show_webcam_select_menu) || {
      back_to show_capture_menu
      return
    }
    manu-capture-screenrecording --with-desktop-audio --with-microphone-audio --with-webcam --webcam-device="$device"
    ;;
  *)
    back_to show_capture_menu
    ;;
  esac
}

show_learn_menu() {
  case $(menu "Learn" "  Hyprland\n  Arch\n  Neovim\n  Bash\n󱣻  Gowall\n󰇥  Yazi\n󰌌  Keybindings") in
  *Hyprland*) manu-launch-webapp "https://wiki.hypr.land/" ;;
  *Arch*) manu-launch-webapp "https://wiki.archlinux.org/title/Main_page" ;;
  *Bash*) manu-launch-webapp "https://devhints.io/bash" ;;
  *Neovim*) manu-launch-webapp "https://www.lazyvim.org/keymaps" ;;
  *Gowall*) manu-launch-webapp "https://achno.github.io/gowall-docs/" ;;
  *Yazi*) manu-launch-webapp "https://yazi-rs.github.io/docs/quick-start/" ;;
  *Keybindings*) manu-menu-keybindings ;;
  *) show_main_menu ;;
  esac
}

show_trigger_menu() {
  case $(menu "Trigger" "󰔛  Reminder\n  Capture\n󰧸  Transcode\n  Share\n󰔎  Toggle\n  Hardware") in
  *Reminder*) show_reminder_menu ;;  *Capture*) show_capture_menu ;;
  *Transcode*) manu-transcode || back_to show_trigger_menu ;;
  *Share*) show_share_menu ;;
  *Toggle*) show_toggle_menu ;;
  *) show_main_menu ;;
  esac
}

show_reminder_menu() {
  case $(menu "Reminder" "󰔛  Set one\n󰔛  Show all\n󰔛  Clear all") in
  *Set*) show_custom_reminder_input ;;
  *"Show all"*) manu-reminder show ;;
  *"Clear all"*) manu-reminder clear ;;
  *) back_to show_trigger_menu ;;
  esac
}

show_custom_reminder_input() {
  local minutes
  minutes=$(manu-menu-input "Remind in minutes")

  if [[ $minutes =~ ^[0-9]+$ ]] && ((minutes > 0)); then
    show_reminder_message_input "$minutes"
  elif [[ -n $minutes ]]; then
    manu-notification-send "󰔛" "Invalid reminder" "Enter the number of minutes" -u critical
    show_custom_reminder_input
  else
    back_to show_reminder_menu
  fi
}

show_reminder_message_input() {
  local minutes="$1"
  local message
  message=$(manu-menu-input "Reminder message")

  if [[ -n $message ]]; then
    manu-reminder "$minutes" "$message"
  else
    manu-reminder "$minutes"
  fi
}

show_share_menu() {
  case $(menu "Share" "  Clipboard\n  File \n  Folder") in
  *Clipboard*) manu-menu-share clipboard ;;
  *File*) terminal bash -c "manu-menu-share file" ;;
  *Folder*) terminal bash -c "manu-menu-share folder" ;;
  *) back_to show_trigger_menu ;;
  esac
}

show_toggle_menu() {
  case $(menu "Toggle" "󱄄  Screensaver\n  Nightlight\n󱫖  Idle Lock\n󰂛  Notifications\n󰖯  Top Bar\n󱂬  Workspace Layout\n  Window Gaps\n  1-Window Ratio\n󰍹  Display Scaling\n󰟵  Sudo Passwordless") in
  *Screensaver*) manu-toggle-screensaver ;;
  *Nightlight*) manu-toggle-night ;;
  *Idle*) manu-toggle-idle ;;
  *Notifications*) manu-toggle-notification-silencing ;;
  *Bar*) manu-toggle-waybar ;;
  *Layout*) manu-hyprland-workspace-layout-toggle ;;
  *Ratio*) manu-hyprland-window-single-square-aspect-toggle ;;
  *Gaps*) manu-hyprland-window-gaps-toggle ;;
  *Scaling*) manu-hyprland-monitor-scaling-cycle ;;
  *"Sudo Passwordless"*) present_terminal manu-sudo-passwordless ;;
  *) show_trigger_menu ;;
  esac
}

show_power_profile_menu() {
  local profile
  profile=$(menu "Power Profile" "$(manu-powerprofiles-list)")
  if [[ -z "$profile" ]]; then
    back_to show_setup_menu
  else
    manu-powerprofiles-set "$profile"
  fi
}

show_style_menu() {
  case $(menu "Style" "󰸌  Theme\n󰉔  Background\n  Font\n  Hyprland\n󱄄  Screensaver\n  About") in
  *Theme*) show_theme_menu ;;
  *Background*) show_background_menu ;;
  *Font*) show_font_menu ;;
  *Hyprland*) open_in_editor ~/.config/hypr/modules/decorations.conf ;;
  *Screensaver*) show_screensaver_menu ;;
  *About*) show_about_menu ;;
  *) show_main_menu ;;
  esac
}

show_about_menu() {
  case $(menu "About" "  Edit Text\n  Set From Image\n  Restore Default") in
  *Text*) manu-branding-about text ;;
  *Image*) manu-branding-about image ;;
  *Default*) manu-branding-about reset ;;
  *) show_style_menu ;;
  esac
}

show_screensaver_menu() {
  case $(menu "Screensaver" "  Edit Text\n  Set From Image\n  Restore Default") in
  *Text*) manu-branding-screensaver text ;;
  *Image*) manu-branding-screensaver image ;;
  *Default*) manu-branding-screensaver reset ;;
  *) show_style_menu ;;
  esac
}

show_theme_menu() {
  manu-launch-walker -m menus:manuthemes --width 800 --minheight 400
}

show_font_menu() {
  theme=$(menu "Font" "$(manu-font-list)" "--width 350" "$(manu-font-current)")
  if [[ "$theme" == "CNCLD" || -z "$theme" ]]; then
    back_to show_style_menu
  else
    manu-font-set "$theme"
  fi
}
show_background_menu() {
  manu-launch-walker -m menus:manuBackgroundSelector --width 800 --minheight 400
}
show_install_menu() {
  case $(menu "Install" "󰣇  Package\n󰣇  AUR\n  Web App\n  TUI\n  Service\n  Style\n󰵮  Development\n  Editor\n  Terminal\n  Browser\n󱚤  AI\n  Gaming\n󰍲  Windows") in
  *Package*) terminal manu-pkg-install ;;
  *AUR*) terminal manu-pkg-aur-install ;;
  *Web*) present_terminal manu-webapp-install ;;
  *TUI*) present_terminal manu-tui-install ;;
  *Service*) show_install_service_menu ;;
  *Style*) show_install_style_menu ;;
  *Development*) show_install_development_menu ;;
  *Editor*) show_install_editor_menu ;;
  *Terminal*) show_install_terminal_menu ;;
  *Browser*) show_install_browser_menu ;;
  *Gaming*) show_install_gaming_menu ;;
  *AI*) show_install_ai_menu ;;
  *Windows*) present_terminal "manu-windows-vm install" ;;
  *) show_main_menu ;;
  esac
}

