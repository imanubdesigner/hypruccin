show_update_menu() {
  case $(menu "Update" "󰣇  Hypruccin\n󰣇  Pacman\n  Firmware\n󰸌  Extra Themes\n󰮢  Process\n󰇅  Hardware\n  Timezone\n  Time\n  Password") in
  *Hypruccin*) present_terminal manu-update ;;
  *Pacman*) show_update_pacman_menu ;;
  *Firmware*) present_terminal manu-update-firmware ;;
  *Themes*) present_terminal manu-theme-update ;;
  *Process*) show_update_process_menu ;;
  *Hardware*) show_update_hardware_menu ;;
  *Timezone*) present_terminal manu-tz-select ;;
  *Time*) present_terminal manu-update-time ;;
  *Password*) present_terminal passwd ;;
  *) show_main_menu ;;
  esac
}

