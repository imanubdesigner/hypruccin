#!/bin/bash

# manu:summary=Ensure all default .desktop, web apps, TUIs, and npx wrappers are installed.

MANU_PATH="$HOME/.local/share/manu"

mkdir -p ~/.local/share/icons/hicolor/48x48/apps/
cp "$MANU_PATH/applications/icons/"*.png ~/.local/share/icons/hicolor/48x48/apps/
gtk-update-icon-cache ~/.local/share/icons/hicolor &>/dev/null

# Copy .desktop declarations
mkdir -p ~/.local/share/applications
cp "$MANU_PATH/applications/"*.desktop ~/.local/share/applications/
cp "$MANU_PATH/applications/hidden/"*.desktop ~/.local/share/applications/ 2>/dev/null

if manu-cmd-present foot; then
  cp "$MANU_PATH/default/foot/foot.desktop" ~/.local/share/applications/
fi

# Refresh the webapps, TUIs, and npx wrappers
bash "$MANU_PATH/install/first-run/manu-first-run-icons"
bash "$MANU_PATH/install/first-run/manu-first-run-webapps"
bash "$MANU_PATH/install/first-run/manu-first-run-tui"
bash "$MANU_PATH/install/first-run/manu-first-run-npx"

update-desktop-database ~/.local/share/applications
