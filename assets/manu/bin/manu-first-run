#!/bin/bash

# manu:summary=Finish the installation of Manu with items that can only be done after logging in.
# manu:requires-sudo=true

# Hibernation is currently disabled. Uncomment (line 52) to enable.

FLAG="$HOME/.local/share/manu/.first-run-done"
LOG="$HOME/.local/share/manu/first-run.log"
# Already ran — exit immediately
[[ -f "$FLAG" ]] && exit 0
mkdir -p "$(dirname "$LOG")"

# Silent execution, all output to log file
{
  echo "$(date): First run started"

  # -------------------- User-Dirs --------------------
  $MANU_PATH/install/first-run/manu-first-run-user-dirs.sh

  # -------------------- GPG --------------------
  $MANU_PATH/install/first-run/manu-first-run-gpg.sh

  # -------------------- Firewall --------------------
  $MANU_PATH/install/first-run/manu-first-run-firewall.sh

  # -------------------- Elephant --------------------
  $MANU_PATH/install/first-run/manu-first-run-elephant.sh

  # -------------------- Default Keyring ------------------
  $MANU_PATH/install/first-run/manu-first-run-default-keyring.sh

  # -------------------- Icons --------------------
  $MANU_PATH/install/first-run/manu-first-run-icons.sh

  # -------------------- Webapps --------------------
  $MANU_PATH/install/first-run/manu-first-run-webapps.sh

  # -------------------- TUI Applications --------------------
  $MANU_PATH/install/first-run/manu-first-run-tui.sh

  # -------------------- NPX Wrapper Scripts --------------------
  $MANU_PATH/install/first-run/manu-first-run-npx.sh

  # -------------------- GNOME / GTK Theme --------------------
  $MANU_PATH/install/first-run/manu-first-run-gnome-theme.sh

  # -------------------- Set Theme --------------------
  $MANU_PATH/install/first-run/manu-first-run-set-theme.sh

  # -------------------- Mise Configuration --------------------
  $MANU_PATH/install/first-run/manu-first-run-mise.sh

  # -------------------- ZSH Configuration --------------------
  $MANU_PATH/install/first-run/manu-first-run-zsh.sh

  # -------------------- XDG user dirs --------------------
  xdg-user-dirs-update

  # -------------------- Hibernation --------------------
  # $MANU_PATH/install/first-run/manu-first-run-hibernation.sh

  # -------------------- Install sddm --------------------
  $MANU_PATH/install/first-run/manu-first-run-sddm.sh

  # -------------------- Snapper + Limine --------------------
  $MANU_PATH/install/first-run/manu-first-run-limine-snapper.sh

  # -------------------- Restore visudo --------------------
  $MANU_PATH/install/first-run/manu-first-run-restore-visudo.sh

  # Mark as done — won't run again
  touch "$FLAG"
  echo "$(date): First run completed successfully."
} >>"$LOG" 2>&1

# Desktop notification with nerd font checkmark
notify-send -t 5000 "First Run Script" "Configuration Complete  "
