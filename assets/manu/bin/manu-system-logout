#!/bin/bash

# manu:summary=Log out after closing application windows
# manu:examples=manu logout | manu system logout
# manu:aliases=manu logout

nohup bash -c "sleep 2 && uwsm stop" >/dev/null 2>&1 &

# Now close all windows
manu-hyprland-window-close-all
sleep 1 # Allow apps like Chrome to shutdown correctly
